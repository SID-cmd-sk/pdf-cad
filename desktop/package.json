{
  "name": "cadassist-desktop",
  "productName": "CAD Assist",
  "version": "1.0.0",
  "description": "Local-first scan → DXF converter with self-learning corrections",
  "main": "main.js",
  "author": "CAD Assist",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:frontend": "cd ../frontend && yarn build && rimraf ../desktop/frontend-build && cpy ../frontend/build/** ../desktop/frontend-build",
    "build:backend:win": "cd ../backend && pyinstaller --noconfirm --onefile --name cadassist-backend --add-data \"processing;processing\" --add-data \"learning;learning\" --add-data \"storage;storage\" server.py",
    "build:backend:unix": "cd ../backend && pyinstaller --noconfirm --onefile --name cadassist-backend --add-data 'processing:processing' --add-data 'learning:learning' --add-data 'storage:storage' server.py",
    "pack:win": "electron-builder --win --x64",
    "pack:mac": "electron-builder --mac",
    "pack:linux": "electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "electron-log": "^5.1.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "cpy-cli": "^5.0.0",
    "rimraf": "^5.0.5"
  },
  "build": {
    "appId": "sh.cadassist.desktop",
    "productName": "CAD Assist",
    "directories": { "output": "dist" },
    "files": [ "main.js", "preload.js", "frontend-build/**", "bin/**" ],
    "extraResources": [
      { "from": "bin", "to": "bin" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "icons/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "icons/icon.icns",
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "icons/icon.png",
      "category": "Graphics"
    }
  }
}
